      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "justMyCode": true,
      "subProcess": true,
      "preLaunchTask": "wait-for-flower-8258",
      "args": [
        "--server", "127.0.0.1:8258",
        "--client_id", "0",
        "--num_clients", "2",
        "--mode", "ZO",
        "--scope", "reduced",
        "--client_zo_q", "1",
        "--lr", "1e-6",
        "--local_epochs", "1",
        "--local_steps", "1",
        "--batch_size", "2",
        "--block_size", "64",
        "--cache_dir", "cache",
        "--sample_count", "16",
        "--device", "cuda",
        "--log_interval", "50",
