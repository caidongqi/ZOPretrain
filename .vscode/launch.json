{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FL Server (Instruct, 3 rounds)",
      "type": "debugpy",
      "request": "launch",
      "program": "/data/pc/ZOPretrain/federated/server_flower.py",
      "cwd": "/data/pc/ZOPretrain",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "justMyCode": true,
      "subProcess": true,
      "args": [
        "--address", "0.0.0.0:8258",
        "--rounds", "10",
        "--min_fit_clients", "2",
        "--min_available_clients", "2",
        "--fraction_fit", "1.0",
        "--fraction_evaluate", "0.0",
        "--device", "cuda",
        "--instruct_enable",
        "--instruct_candidate_pool", "64",
        "--instruct_topk", "4",
        "--instruct_dir_count", "2",
        "--instruct_eval_steps", "1",
        "--server_zo_epsilon", "1e-4",
        "--server_zo_lr", "1e-6",
        "--server_zo_optimizer", "adam",
        "--server_zo_betas", "0.9", "0.999",
        "--server_zo_eps", "1e-8",
        "--server_zo_weight_decay", "0.0"
      ],
      "env": {
        "PYTHONPATH": "/data/pc/ZOPretrain",
        "CUDA_VISIBLE_DEVICES": "6",
        "FLWR_LOGLEVEL": "DEBUG",
        "NO_PROXY": "127.0.0.1,localhost",
        "no_proxy": "127.0.0.1,localhost",
        "GRPC_ENABLE_HTTP_PROXY": "0",
        "GRPC_MAX_SEND_MESSAGE_LENGTH": "2147483647",
        "GRPC_MAX_RECEIVE_MESSAGE_LENGTH": "2147483647"
      }
    },
    {
      "name": "FL Client Strong (Instruct)",
      "type": "debugpy",
      "request": "launch",
      "program": "/data/pc/ZOPretrain/federated/client_flower.py",
